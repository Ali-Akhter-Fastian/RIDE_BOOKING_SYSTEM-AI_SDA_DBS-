# -------------------------------------------------------
# Ride Booking API — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# -------------------------------------------------------

# PostgreSQL connection string (asyncpg driver)
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Alembic strips the +asyncpg part automatically via migrations/env.py
DB_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ride_booking
# JWT — must match the secret used by your auth service
JWT_SECRET=change-me
JWT_ALGORITHM=HS256

# Token expiry (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# DB connection pool sizes
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10
